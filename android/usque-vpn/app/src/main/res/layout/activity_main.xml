<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Logo/Icon -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_vpn"
            android:layout_marginBottom="24dp" />

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usque VPN"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cloudflare WARP / MASQUE"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginBottom="24dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textSize="12sp"
                android:textColor="#888888"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disconnected"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#ff6b6b"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your IP Address"
                android:textSize="12sp"
                android:textColor="#888888"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/ip_info_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not registered"
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Connection Settings Preview -->
            <TextView
                android:id="@+id/mode_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mode: HTTP/3 (QUIC)"
                android:textSize="12sp"
                android:textColor="#aaaaaa" />

            <TextView
                android:id="@+id/sni_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SNI: api.cloudflare.com"
                android:textSize="12sp"
                android:textColor="#aaaaaa"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/endpoint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Endpoint: 162.159.198.1:443"
                android:textSize="12sp"
                android:textColor="#aaaaaa"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/dns_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DNS: Cloudflare (1.1.1.1)"
                android:textSize="12sp"
                android:textColor="#aaaaaa"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/tuning_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keepalive: 30s | MTU: 1280"
                android:textSize="12sp"
                android:textColor="#aaaaaa"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <!-- Action Buttons Grid / Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/settings_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="⚙ Settings"
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:background="@drawable/button_secondary_background"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/logs_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="📜 Logs"
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:background="@drawable/button_secondary_background"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <!-- Primary Connect / Disconnect Button -->
        <Button
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Connect"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:background="@drawable/button_background"
            android:layout_marginBottom="16dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Powered by usque"
            android:textSize="11sp"
            android:textColor="#555555"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>